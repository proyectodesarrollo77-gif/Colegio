# ==========================================================================
# PL_SGE - Variables de entorno
# Copie este archivo como .env y ajuste los valores de su instalacion.
# ==========================================================================

# ---- Django ----
DJANGO_SECRET_KEY=cambie-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIMEZONE=America/Bogota
DJANGO_LANGUAGE=es-co

# ---- PostgreSQL ----
DB_ENGINE=postgresql
DB_NAME=pl_sge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ---- Sesiones y JWT ----
SESSION_COOKIE_AGE=28800
SESSION_IDLE_TIMEOUT=3600
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Seguridad ----
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_ISSUER=PL_SGE
SECURE_SSL_REDIRECT=False

# ---- Correo ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PL_SGE <no-reply@datly.local>

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
